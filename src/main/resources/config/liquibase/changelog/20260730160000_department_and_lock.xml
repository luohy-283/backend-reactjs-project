<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260730160000-1-department" author="bookingroom">
        <createTable tableName="department">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260730160000-2-user-department" author="bookingroom">
        <addColumn tableName="jhi_user">
            <column name="department_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="jhi_user"
            baseColumnNames="department_id"
            referencedTableName="department"
            referencedColumnNames="id"
            constraintName="fk_user_department_id"/>
    </changeSet>

    <changeSet id="20260730160000-3-room-lock" author="bookingroom">
        <addColumn tableName="room">
            <column name="locked_department_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="room"
            baseColumnNames="locked_department_id"
            referencedTableName="department"
            referencedColumnNames="id"
            constraintName="fk_room_locked_department_id"/>
    </changeSet>

    <changeSet id="20260730160000-4-dept-change-request" author="bookingroom">
        <createTable tableName="department_change_request">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="requested_department_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="reviewed_by_id" type="bigint"/>
            <column name="reviewed_date" type="timestamp"/>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="department_change_request"
            baseColumnNames="user_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"
            constraintName="fk_dept_change_user_id"/>
        <addForeignKeyConstraint
            baseTableName="department_change_request"
            baseColumnNames="requested_department_id"
            referencedTableName="department"
            referencedColumnNames="id"
            constraintName="fk_dept_change_requested_dept_id"/>
        <addForeignKeyConstraint
            baseTableName="department_change_request"
            baseColumnNames="reviewed_by_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"
            constraintName="fk_dept_change_reviewed_by_id"/>
    </changeSet>

    <changeSet id="20260730160000-5-seed-departments" author="bookingroom">
        <insert tableName="department">
            <column name="id" valueNumeric="1"/>
            <column name="code" value="IT"/>
            <column name="name" value="Công nghệ thông tin"/>
        </insert>
        <insert tableName="department">
            <column name="id" valueNumeric="2"/>
            <column name="code" value="HR"/>
            <column name="name" value="Nhân sự"/>
        </insert>
        <insert tableName="department">
            <column name="id" valueNumeric="3"/>
            <column name="code" value="SALES"/>
            <column name="name" value="Kinh doanh"/>
        </insert>
        <sql>SELECT setval('sequence_generator', GREATEST((SELECT MAX(id) FROM department), nextval('sequence_generator') - 1))</sql>
    </changeSet>

    <changeSet id="20260730160000-6-seed-assign" author="bookingroom">
        <update tableName="jhi_user">
            <column name="department_id" valueNumeric="1"/>
            <where>id = 1</where>
        </update>
        <update tableName="jhi_user">
            <column name="department_id" valueNumeric="1"/>
            <where>id = 2</where>
        </update>
        <update tableName="room">
            <column name="locked_department_id" valueNumeric="1"/>
            <where>id = 1</where>
        </update>
    </changeSet>
</databaseChangeLog>
