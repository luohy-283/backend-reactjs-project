    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Seed room equipment + VIP flags + sample purchase requests for demo / 3D viewer.
      Equipment catalog ids (from 20260813120000-5): 1 projector, 2 display, 3 audio, 4 VC, 5 mic.
    -->
    <changeSet id="20260813160000-seed-room-equipment" author="bookingroom">
        <update tableName="room">
            <column name="is_vip" valueBoolean="true"/>
            <column name="vip_amenities" value="VIDEO_4K,SOUNDPROOF"/>
            <where>id = 3</where>
        </update>
        <update tableName="room">
            <column name="is_vip" valueBoolean="true"/>
            <column name="vip_amenities" value="VIDEO_4K,SOUNDPROOF,CATERING,DEDICATED_SUPPORT"/>
